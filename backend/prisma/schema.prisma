generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum GlobalRole {
  USER
  RECHARGE_MANAGER
  OWNER
}

enum RechargeAgentRole {
  MASTER
  SUB_AGENT
}

enum RechargeAgencyStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  SUSPENDED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum RechargeTransactionStatus {
  SUCCESS
  FAILED
  REVERSED
}

enum WalletOwnerType {
  AGENCY
  AGENT
}

enum NotificationType {
  APPLICATION_APPROVED
  APPLICATION_REJECTED
  APPLICATION_CHANGES_REQUESTED
  APPLICATION_SUSPENDED
  WALLET_CREDITED
  WALLET_DEBITED
  CHARGE_SUCCESS
  CHARGE_FAILED
  TOPUP_REQUEST_SUBMITTED
  TOPUP_REQUEST_APPROVED
  TOPUP_REQUEST_REJECTED
  WITHDRAWAL_REQUESTED
  WITHDRAWAL_APPROVED
  WITHDRAWAL_REJECTED
  LOW_BALANCE
  NEW_DEVICE_LOGIN
  NEW_MESSAGE
  ROOM_KICKED
  ROOM_BANNED
  ROOM_ROLE_CHANGED
  GIFT_RECEIVED
  GIFT_LUCKY_WIN
  GAME_WIN
}

enum GiftType {
  STATIC
  LUCKY
}

enum GameType {
  DICE_GUESS
  LUCKY_WHEEL
  SLOT_MACHINE
  CRASH_GUESS
}

enum RoomMemberRole {
  OWNER
  CO_OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum RoomEventType {
  ROOM_CREATED
  ROOM_UPDATED
  MEMBER_JOINED
  MEMBER_LEFT
  SEAT_TAKEN
  SEAT_LEFT
  SEAT_MUTED
  SEAT_UNMUTED
  SEAT_LOCKED
  SEAT_UNLOCKED
  MEMBER_KICKED
  MEMBER_BANNED
  MEMBER_UNBANNED
  ROLE_CHANGED
}

// ---------------------------------------------------------------------------
// Identity & Access
// ---------------------------------------------------------------------------

model User {
  id                  String     @id @default(uuid())
  email               String?    @unique
  phone               String?    @unique
  passwordHash        String
  fullName            String
  username            String     @unique
  avatarUrl           String?
  bio                 String?
  country             String?
  globalRole          GlobalRole @default(USER)
  isActive            Boolean    @default(true)
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?

  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions             Session[]
  loginHistory         LoginHistory[]
  notifications        Notification[]
  auditLogs            AuditLog[]                  @relation("AuditActor")
  rechargeApplication  RechargeAgencyApplication?
  rechargeAgent        RechargeAgent?
  ownedRechargeAgency  RechargeAgency?
  reviewedApplications RechargeAgencyApplication[] @relation("ApplicationReviewer")
  reviewedTopUps       TopUpRequest[]              @relation("TopUpReviewer")
  reviewedWithdrawals  WithdrawalRequest[]         @relation("WithdrawalReviewer")

  ownedRooms           Room[]
  roomMemberships      RoomMember[]
  roomSeats            RoomSeat[]
  roomEventsActed      RoomEvent[]           @relation("RoomEventActor")
  conversationsAsA     Conversation[]        @relation("ConversationUserA")
  conversationsAsB     Conversation[]        @relation("ConversationUserB")
  conversationSettings ConversationSetting[]
  sentMessages         Message[]
  messageReadReceipts  MessageReadReceipt[]
  blockedUsers         BlockedUser[]         @relation("BlockerRelation")
  blockedByUsers       BlockedUser[]         @relation("BlockedRelation")
  messageReports       MessageReport[]

  wallet        UserWallet?
  giftsSent     GiftSend[]  @relation("GiftSender")
  giftsReceived GiftSend[]  @relation("GiftRecipient")
  gameRounds    GameRound[]

  @@index([globalRole])
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  device           String?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  @@index([userId])
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  device    String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

// ---------------------------------------------------------------------------
// Recharge Agency System (نظام وكالات الشحن)
// ---------------------------------------------------------------------------

model RechargeAgencyApplication {
  id                 String            @id @default(uuid())
  applicantId        String            @unique
  applicant          User              @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  fullName           String
  agencyName         String
  country            String
  city               String
  phone              String
  email              String
  paymentMethods     String[]
  previousExperience String?
  yearsOfExperience  Int?
  socialLinks        Json?
  idDocumentUrl      String?
  termsAccepted      Boolean           @default(false)
  status             ApplicationStatus @default(PENDING)
  reviewedById       String?
  reviewer           User?             @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNotes        String?
  reviewedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  agency RechargeAgency?

  @@index([status])
}

model RechargeAgency {
  id             String                    @id @default(uuid())
  applicationId  String                    @unique
  application    RechargeAgencyApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  name           String
  country        String
  city           String
  ownerId        String                    @unique
  owner          User                      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  status         RechargeAgencyStatus      @default(ACTIVE)
  commissionRate Decimal                   @default(2.0) @db.Decimal(5, 2)
  monthlyTarget  Decimal?                  @db.Decimal(14, 2)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  agents  RechargeAgent[]
  wallets RechargeWallet[]

  @@index([status])
}

model RechargeAgent {
  id             String               @id @default(uuid())
  userId         String               @unique
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  agencyId       String
  agency         RechargeAgency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  role           RechargeAgentRole    @default(SUB_AGENT)
  commissionRate Decimal              @default(5.0) @db.Decimal(5, 2)
  status         RechargeAgencyStatus @default(ACTIVE)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  wallet             RechargeWallet?
  topUpRequests      TopUpRequest[]
  withdrawalRequests WithdrawalRequest[]
  transactions       RechargeTransaction[]

  @@index([agencyId])
}

model RechargeWallet {
  id            String          @id @default(uuid())
  ownerType     WalletOwnerType
  agencyId      String?         @unique
  agency        RechargeAgency? @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agentId       String?         @unique
  agent         RechargeAgent?  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  balance       Decimal         @default(0) @db.Decimal(14, 2)
  frozenBalance Decimal         @default(0) @db.Decimal(14, 2)
  currency      String          @default("USD")
  updatedAt     DateTime        @updatedAt
  createdAt     DateTime        @default(now())
}

model TopUpRequest {
  id            String        @id @default(uuid())
  agentId       String
  agent         RechargeAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(14, 2)
  paymentMethod String
  proofUrl      String?
  status        RequestStatus @default(PENDING)
  reviewedById  String?
  reviewer      User?         @relation("TopUpReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNotes   String?
  reviewedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([agentId, status])
}

model WithdrawalRequest {
  id            String        @id @default(uuid())
  agentId       String
  agent         RechargeAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(14, 2)
  method        String
  accountNumber String
  notes         String?
  status        RequestStatus @default(PENDING)
  reviewedById  String?
  reviewer      User?         @relation("WithdrawalReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNotes   String?
  reviewedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([agentId, status])
}

model RechargeTransaction {
  id                String                    @id @default(uuid())
  transactionNumber String                    @unique
  idempotencyKey    String                    @unique
  agentId           String
  agent             RechargeAgent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  targetUserId      String
  amount            Decimal                   @db.Decimal(14, 2)
  currency          String                    @default("USD")
  agentCommission   Decimal                   @db.Decimal(14, 2)
  agencyCommission  Decimal                   @db.Decimal(14, 2)
  platformShare     Decimal                   @db.Decimal(14, 2)
  status            RechargeTransactionStatus @default(SUCCESS)
  ipAddress         String?
  device            String?
  paymentMethod     String?
  notes             String?
  createdAt         DateTime                  @default(now())

  @@index([agentId, createdAt])
  @@index([targetUserId, createdAt])
}

model CommissionSettings {
  id                    String   @id @default("default")
  agentCommissionRate   Decimal  @default(5.0) @db.Decimal(5, 2)
  agencyCommissionRate  Decimal  @default(2.0) @db.Decimal(5, 2)
  platformRate          Decimal  @default(93.0) @db.Decimal(5, 2)
  dailyChargeLimit      Decimal  @default(5000) @db.Decimal(14, 2)
  dailyWithdrawLimit    Decimal  @default(2000) @db.Decimal(14, 2)
  largeTransactionAlert Decimal  @default(1000) @db.Decimal(14, 2)
  goldPerCurrencyUnit   Decimal  @default(100) @db.Decimal(10, 2)
  updatedAt             DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Voice Rooms (الغرف الصوتية)
// ---------------------------------------------------------------------------

model Room {
  id                  String   @id @default(uuid())
  name                String
  ownerId             String
  owner               User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  isPasswordProtected Boolean  @default(false)
  passwordHash        String?
  seatCount           Int      @default(8)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  members RoomMember[]
  seats   RoomSeat[]
  events  RoomEvent[]
  gifts   GiftSend[]
  games   GameRound[]

  @@index([isActive])
}

model RoomMember {
  id       String         @id @default(uuid())
  roomId   String
  room     Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId   String
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     RoomMemberRole @default(MEMBER)
  isMuted  Boolean        @default(false)
  isBanned Boolean        @default(false)
  joinedAt DateTime       @default(now())

  @@unique([roomId, userId])
  @@index([roomId])
}

model RoomSeat {
  id         String   @id @default(uuid())
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  seatNumber Int
  occupantId String?
  occupant   User?    @relation(fields: [occupantId], references: [id], onDelete: SetNull)
  isLocked   Boolean  @default(false)
  isMuted    Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  @@unique([roomId, seatNumber])
}

model RoomEvent {
  id           String        @id @default(uuid())
  roomId       String
  room         Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  actorId      String?
  actor        User?         @relation("RoomEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUserId String?
  type         RoomEventType
  metadata     Json?
  createdAt    DateTime      @default(now())

  @@index([roomId, createdAt])
}

// ---------------------------------------------------------------------------
// Private Messaging (الرسائل الخاصة)
// ---------------------------------------------------------------------------

model Conversation {
  id        String   @id @default(uuid())
  userAId   String
  userA     User     @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId   String
  userB     User     @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]
  settings ConversationSetting[]

  @@unique([userAId, userBId])
}

model ConversationSetting {
  id                String       @id @default(uuid())
  conversationId    String
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  isPinned          Boolean      @default(false)
  isMuted           Boolean      @default(false)
  lastReadMessageId String?

  @@unique([conversationId, userId])
}

model Message {
  id              String       @id @default(uuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body            String
  replyToId       String?
  replyTo         Message?     @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies         Message[]    @relation("MessageReply")
  forwardedFromId String?
  isEdited        Boolean      @default(false)
  isDeleted       Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  readReceipts MessageReadReceipt[]
  reports      MessageReport[]

  @@index([conversationId, createdAt])
}

model MessageReadReceipt {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@unique([messageId, userId])
}

model BlockedUser {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("BlockerRelation", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlockedRelation", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model MessageReport {
  id         String   @id @default(uuid())
  messageId  String
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  createdAt  DateTime @default(now())

  @@index([messageId])
}

// ---------------------------------------------------------------------------
// User Wallet, Gifts & Betting Games (المحفظة، الهدايا، ألعاب الرهان)
// ---------------------------------------------------------------------------

model UserWallet {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goldBalance    Decimal  @default(0) @db.Decimal(14, 2)
  diamondBalance Decimal  @default(0) @db.Decimal(14, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Gift {
  id               String   @id @default(uuid())
  name             String
  iconUrl          String?
  price            Decimal  @db.Decimal(10, 2)
  type             GiftType @default(STATIC)
  isActive         Boolean  @default(true)
  diamondShareRate Decimal  @default(50.0) @db.Decimal(5, 2)
  luckyOdds        Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sends GiftSend[]
}

model GiftSend {
  id              String   @id @default(uuid())
  senderId        String
  sender          User     @relation("GiftSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId     String
  recipient       User     @relation("GiftRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  giftId          String
  gift            Gift     @relation(fields: [giftId], references: [id], onDelete: Restrict)
  roomId          String?
  room            Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  quantity        Int      @default(1)
  totalGoldCost   Decimal  @db.Decimal(14, 2)
  diamondsAwarded Decimal  @db.Decimal(14, 2)
  isLucky         Boolean  @default(false)
  luckyMultiplier Decimal? @db.Decimal(6, 2)
  luckyPayoutGold Decimal? @db.Decimal(14, 2)
  createdAt       DateTime @default(now())

  @@index([recipientId, createdAt])
  @@index([senderId, createdAt])
  @@index([roomId, createdAt])
}

model GameRound {
  id           String   @id @default(uuid())
  gameType     GameType @default(DICE_GUESS)
  playerId     String
  player       User     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  roomId       String?
  room         Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  betAmount    Decimal  @db.Decimal(14, 2)
  choice       Int
  rolledNumber Int
  multiplier   Decimal  @db.Decimal(6, 2)
  payout       Decimal  @db.Decimal(14, 2)
  isWin        Boolean
  createdAt    DateTime @default(now())

  @@index([playerId, createdAt])
  @@index([roomId, createdAt])
}

model GameSettings {
  id            String   @id
  minBet        Decimal  @default(10) @db.Decimal(14, 2)
  maxBet        Decimal  @default(5000) @db.Decimal(14, 2)
  winMultiplier Decimal  @default(9.0) @db.Decimal(6, 2)
  dailyBetLimit Decimal  @default(20000) @db.Decimal(14, 2)
  config        Json?
  updatedAt     DateTime @updatedAt
}
