NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://code:code@localhost:5432/code?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

THROTTLE_TTL=60
THROTTLE_LIMIT=100

RECHARGE_DAILY_CHARGE_LIMIT=5000
RECHARGE_DAILY_WITHDRAW_LIMIT=2000
RECHARGE_LARGE_TRANSACTION_THRESHOLD=1000

# Public URL this API is reachable at (used to build links to locally-stored uploads
# when object storage below isn't configured). In production this is your https://api domain.
PUBLIC_API_URL=http://localhost:3000

# Object storage (Cloudflare R2 or AWS S3) for user-uploaded images.
# Leave all four blank to fall back to local disk storage under ./uploads — fine for
# development, but production should always point these at real R2/S3 credentials so
# images are never stored on the app server itself.
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=

# Firebase Cloud Messaging — base64-encode your Firebase service account JSON file
# (e.g. `base64 -w0 service-account.json`) and paste the result here. Leave blank to
# disable push notifications (in-app notifications still work without this).
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# Agora (real-time voice) — from your Agora Console project. Leave blank to disable
# the /rooms/:id/agora-token endpoint (it will respond with 503).
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Structured logging level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
